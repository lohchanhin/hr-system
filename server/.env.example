PORT=3000
MONGODB_URI=mongodb://localhost/hr
# JWT signing secret (required)
JWT_SECRET=replace-with-at-least-32-random-bytes
# Only used when the database has no administrator. Remove these values after
# the first successful bootstrap, or keep them in a protected secret manager.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-unique-15-character-password
# Set to the exact number of trusted reverse-proxy hops after adding HTTPS.
# TRUST_PROXY_HOPS=1
# ENABLE_HSTS=true
# JSON_BODY_LIMIT=2mb
# URLENCODED_BODY_LIMIT=256kb
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_ACCOUNT_MAX=5
# LOGIN_RATE_LIMIT_IP_MAX=50
# General limit applied to every /api request (GET included): counted per signed-in
# account, or per IP for requests without a valid token (the login page).
# API_RATE_LIMIT_WINDOW_MS=60000
# API_RATE_LIMIT_MAX=300
# Tighter limit (same per-account / per-IP counting) applied only to state-changing requests
# (POST/PUT/PATCH/DELETE) -- bulk import, payroll recalculation, approvals, etc.
# API_MUTATION_RATE_LIMIT_WINDOW_MS=60000
# API_MUTATION_RATE_LIMIT_MAX=60
# Wrong old-password attempts on POST /api/change-password, per account.
# CHANGE_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
# CHANGE_PASSWORD_RATE_LIMIT_MAX=10
# Optional: Frontend URL for CORS (e.g., https://your-domain.com)
# FRONTEND_URL=https://hr-system-d7fc5ea7aab1.herokuapp.com
# Optional: time zone used for shift times, punch windows and "today" (default Asia/Taipei).
# The server itself may run in UTC; business dates are always evaluated in this zone.
# ATTENDANCE_TIMEZONE=Asia/Taipei
# Optional: set to "off" to stop the daily check of the government office calendar
# (and the daily holiday-compensation sync that runs with it).
# HOLIDAY_CALENDAR_WATCHER=off
# Optional: requests slower than this many milliseconds are logged (default 500).
# SLOW_REQUEST_THRESHOLD_MS=500
# Optional: a font file with Traditional Chinese glyphs for PDF exports, when the bundled
# fonts in server/fonts are not installed (see server/setup-fonts.sh).
# PDF_CHINESE_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# PDF_CHINESE_FONT_NAME=NotoSansCJKtc-Regular
